  "overview": {
    "goal": "Launch a self-service portal that resolves 60% of support requests without an agent by March 2027.",
    "problem": "The legacy portal is unsupported, fails accessibility audits and pushes 70% of customers to the phone line.",
    "scope": {
      "in": [
        "Account, billing and case management journeys",
        "Migration of active customer accounts",
        "SSO with the corporate identity provider",
        "WCAG 2.2 AA compliance"
      ],
      "out": [
        "Native mobile apps",
        "Partner portal",
        "Replacing the CRM"
      ]
    },
    "success_criteria": [
      {
        "label": "Self-service resolution rate",
        "target": "≥ 60%"
      },
      {
        "label": "Customer satisfaction (CSAT)",
        "target": "≥ 4.3 / 5"
      },
      {
        "label": "Accessibility audit",
        "target": "0 critical findings"
      },
      {
        "label": "Legacy portal",
        "target": "Decommissioned"
      }
    ],
    "assumptions": [
      "The design system team delivers form components by October",
      "CRM API rate limits allow 50 req/s"
    ],
    "constraints": [
      "Launch freeze from 18 Dec to 6 Jan",
      "Budget fixed at €420k"
    ]
  },
